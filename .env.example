# ── Core ─────────────────────────────────────────────────────────────
# PostgreSQL 14+ connection string
DATABASE_URL=postgresql://epm:change-me@localhost:5432/epm?schema=public
# Public URL of the app (used in emails and the WebSocket origin check)
APP_URL=http://localhost:3000
PORT=3000
# The Docker image runs `prisma migrate deploy` on start unless this is "false"
RUN_MIGRATIONS=true
# 32+ random characters. Encrypts stored SSH/RDP/mailbox credentials (AES-256-GCM).
# Generate with: openssl rand -base64 48   — changing it makes stored credentials unreadable.
APP_ENCRYPTION_KEY=
# Sessions
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
PASSWORD_MIN_LENGTH=10
# Set to "false" only when running production behind plain HTTP (not recommended)
COOKIE_SECURE=true

# ── Outgoing email (optional; without it notifications are in-app only) ──
# Option 1: Brevo HTTPS API (use where SMTP ports are blocked, e.g. Render's free tier)
BREVO_API_KEY=
# Sender for either option: "Name <address>" or an address (verified in Brevo when using Brevo)
MAIL_FROM=
# Option 2: SMTP relay
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# "off" keeps SMTP for invites/resets but stops notification emails
EMAIL_NOTIFICATIONS=on

# ── File storage ────────────────────────────────────────────────────
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
UPLOAD_MAX_MB=25
# For STORAGE_DRIVER=s3 (AWS S3, MinIO, Ceph …)
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
# Path-style URLs; defaults to true when STORAGE_S3_ENDPOINT is set (Supabase Storage, MinIO need it)
STORAGE_S3_FORCE_PATH_STYLE=

# ── Technical portal ────────────────────────────────────────────────
# Idle minutes before SSH/RDP sessions are closed
TECH_IDLE_MINUTES=30
# Apache Guacamole proxy daemon for in-browser RDP (leave empty to offer .rdp download only)
GUACD_HOST=
GUACD_PORT=4822

# ── Scheduled jobs ──────────────────────────────────────────────────
# Bearer token for POST /api/jobs/reminders (call from cron every hour)
CRON_SECRET=

# ── Demo seed only ──────────────────────────────────────────────────
DEMO_PASSWORD=
